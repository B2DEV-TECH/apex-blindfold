app BLINDFOLD (
    name: APEX Blindfold
    version: 0.1.0
    logo {
        type: text
        text: &APP_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    css {
        fileUrls: #APP_FILES#blindfold/blindfold.css
    }
    javaScript {
        fileUrls: #APP_FILES#blindfold/boot.js
    }
    security {
        allowBotAccess: true
    }
    availability {
        status: available
    }
    sessionManagement {
        rejoinSessions: publicSessions
        maxSessionLength: 43200
        maxSessionIdleTime: 43200
    }
    runtime {
        allowFeedback: false
        debugging: true
        compatibilityMode: 24.2
    }
    advanced {
        modernizeApp: true
    }
)
