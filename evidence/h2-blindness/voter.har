     "content": {
      "size": 29938,
      "mimeType": "text/html;charset=utf-8",
      "text": "<!DOCTYPE html>\n<html class=\"no-js  page-2 app-BLINDFOLD\" lang=\"en\" >\n<head>\n  <meta charset=\"utf-8\">\n  <title>What the database sees | APEX Blindfold</title>\n  <base href=\"/ords/\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/Core.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/Theme-Standard.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/libraries/apex-utility-css/26.2.5/util-base.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/WebComponents.css?v=26.2.0\" type=\"text/css\" />\n\n  <link rel=\"stylesheet\" href=\"/i/libraries/font-apex/2.5.1/css/font-apex.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/themes/theme_42/26.1/css/Core.css?v=26.2.0\" type=\"text/css\" />\n\n  \n  <link rel=\"stylesheet\" href=\"/i/themes/theme_42/26.1/css/Vita-Dark.css?v=26.2.0\" type=\"text/css\" />\n\n  <link rel=\"stylesheet\" href=\"r/blindfold/2620/files/static/v<id>/blindfold/blindfold.css\" type=\"text/css\" />\n\n  \n  <link rel=\"apple-touch-icon\" href=\"r/blindfold/2620/files/static/v<id>/icons/app-icon-192.png\" /><link rel=\"icon\" href=\"r/blindfold/2620/files/static/v<id>/icons/app-icon-32.png\" />\n  \n\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <meta name=\"app-version\" content=\"0.1.0\" />\n  <meta name=\"app-tenant-id\" content=\"\" />\n  <meta name=\"app-alias\" content=\"BLINDFOLD\" />\n  <meta name=\"app-page-alias\" content=\"LEDGER\" />\n</head>\n<body class=\"t-PageBody t-PageBody--hideLeft t-PageBody--hideActions t-PageBody--blank no-anim bf-page t-PageBody--contain apex-side-nav apex-icons-fontapex apex-theme-vita-dark\"   id=\"t_PageBody\">\n<noscript class=\"t-PageBody-noScript\">You must run this product with JavaScript enabled</noscript>\n<a href=\"#main\" id=\"t_Body_skipToContent\">Skip to Main Content</a>\n<form role=\"none\" action=\"wwv_flow.accept?p_context=blindfold/ledger/<id>\" method=\"post\" name=\"wwv_flow\" id=\"wwvFlowForm\" data-oj-binding-provider=\"none\" novalidate  autocomplete=\"off\">\n<input type=\"hidden\" name=\"p_flow_id\" value=\"2620\" id=\"pFlowId\" /><input type=\"hidden\" name=\"p_flow_step_id\" value=\"2\" id=\"pFlowStepId\" /><input type=\"hidden\" name=\"p_instance\" value=\"<id>\" id=\"pInstance\" /><input type=\"hidden\" name=\"p_page_submission_id\" value=\"MzE5NDY0ODcxMzE2MTc0Nzk3OTI4NDQ2NDMyNDI3NDQyOTEwMDQ0&#x2F;D8XdzH7bsvdEZpHmSBujJZAGCD7PWBFF7CpaeoY18nbCVR3MAnnoYzE6sketHCXYiJzceVSKQtGj0NKxNO53zA\" id=\"pPageSubmissionId\" /><input type=\"hidden\" name=\"p_request\" value=\"\" id=\"pRequest\" /><input type=\"hidden\" name=\"p_reload_on_submit\" value=\"S\" id=\"pReloadOnSubmit\" /><input type=\"hidden\" value=\"blindfold&#x2F;ledger&#x2F;<id>\" id=\"pContext\" /><input type=\"hidden\" value=\"<id>\" id=\"pSalt\" /><input type=\"hidden\" name=\"p_debug\" value=\"LEVEL9\" id=\"pdebug\" />\n<main id=\"main\" class=\"t-Body-contentInner\">\n  <span id=\"APEX_SUCCESS_MESSAGE\" data-template-id=\"<id>_S\" class=\"apex-page-success u-hidden\"></span><span id=\"APEX_ERROR_MESSAGE\" data-template-id=\"<id>_E\" class=\"apex-page-error u-hidden\"></span>\n  <div id=\"R<id>\" class=\"\"  >               <div class=\"bf-shell\" data-bf-page=\"ledger\">\n                 <section class=\"bf-hero\">\n                   <p class=\"bf-eyebrow\">Full DBA view &middot; nothing hidden</p>\n                   <h1 class=\"bf-title\">What the database sees</h1>\n                   <p class=\"bf-lede\">Every vote of the election is on this page. <strong>None of them can be read here.</strong> The key that opens them was generated in a browser and never reached the server.</p>\n                 </section>\n\n                 <div class=\"bf-stats\">\n                   <div class=\"bf-stat\"><span class=\"bf-stat__value\" data-bf-stat=\"ballots\">0</span><span class=\"bf-stat__name\">Ballots</span></div>\n                   <div class=\"bf-stat\"><span class=\"bf-stat__value\" data-bf-stat=\"rows\">0</span><span class=\"bf-stat__name\">Ciphertext rows</span></div>\n                   <div class=\"bf-stat\"><span class=\"bf-stat__value\" data-bf-stat=\"bytes\">0</span><span class=\"bf-stat__name\">Hex characters stored</span></div>\n                   <div class=\"bf-stat bf-stat--zero\"><span class=\"bf-stat__value\">0</span><span class=\"bf-stat__name\">Votes in the clear</span></div>\n                 </div>\n\n                 <div class=\"bf-table-head\">\n                   <div>\n                     <h2>BLIND_BALLOTS</h2>\n                     <p>One ciphertext per option per ballot: Enc(1) for the choice, Enc(0) for the others. No voter, no timestamp.</p>\n                   </div>\n                   <button class=\"bf-button bf-button--ghost\" id=\"bf-refresh\" type=\"button\">Refresh</button>\n                 </div>\n                 <code class=\"bf-sql\">select ballot_id, candidate_id, vote_enc\n from blind_ballots\norder by ballot_id, candidate_id</code>\n               </div>\n               </div><div id=\"bf-ballots\" class=\"bf-report\"  ><div id=\"report_<id>_catch\"><div class=\"t-Report \" id=\"report_bf-ballots\"  data-region-id=\"bf-ballots\">\n  <div class=\"t-Report-wrap\">\n    <table class=\"t-Report-pagination\" role=\"presentation\"><tr><td></td></tr></table>\n    <div class=\"t-Report-tableWrap\">\n    <table class=\"t-Report-report\" id=\"report_table_bf-ballots\" aria-label=\"BLIND_BALLOTS\">\n<thead><tr><th class=\"t-Report-colHead\"   align=\"left\"  id=\"BALLOT_ID\" >BALLOT_ID</th><th class=\"t-Report-colHead\"   align=\"left\"  id=\"CANDIDATE_ID\" >CANDIDATE_ID</th><th class=\"t-Report-colHead\"   align=\"left\"  id=\"VOTE_ENC\" >VOTE_ENC</th></tr></thead>\n<tbody>\n<tr><td class=\"t-Report-cell\"  headers=\"BALLOT_ID\"><span class=\"bf-cell-num\">1</span></td><td class=\"t-Report-cell\"  headers=\"CANDIDATE_ID\"><spa