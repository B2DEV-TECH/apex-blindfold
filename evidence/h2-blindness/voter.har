      "text": "<!DOCTYPE html>\n<html class=\"no-js  page-1 app-BLINDFOLD\" lang=\"en\" >\n<head>\n  <meta charset=\"utf-8\">\n  <title>Vote | APEX Blindfold</title>\n  <base href=\"/ords/\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/Core.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/Theme-Standard.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/libraries/apex-utility-css/26.2.5/util-base.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/app_ui/css/WebComponents.css?v=26.2.0\" type=\"text/css\" />\n\n  <link rel=\"stylesheet\" href=\"/i/libraries/font-apex/2.5.1/css/font-apex.css?v=26.2.0\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/i/themes/theme_42/26.1/css/Core.css?v=26.2.0\" type=\"text/css\" />\n\n  \n  <link rel=\"stylesheet\" href=\"/i/themes/theme_42/26.1/css/Vita-Dark.css?v=26.2.0\" type=\"text/css\" />\n\n  <link rel=\"stylesheet\" href=\"r/blindfold/2620/files/static/v<id>/blindfold/blindfold.css\" type=\"text/css\" />\n\n  \n  <link rel=\"apple-touch-icon\" href=\"r/blindfold/2620/files/static/v<id>/icons/app-icon-192.png\" /><link rel=\"icon\" href=\"r/blindfold/2620/files/static/v<id>/icons/app-icon-32.png\" />\n  \n\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <meta name=\"app-version\" content=\"0.1.0\" />\n  <meta name=\"app-tenant-id\" content=\"\" />\n  <meta name=\"app-alias\" content=\"BLINDFOLD\" />\n  <meta name=\"app-page-alias\" content=\"VOTE\" />\n</head>\n<body class=\"t-PageBody t-PageBody--hideLeft t-PageBody--hideActions t-PageBody--blank no-anim bf-page t-PageBody--contain apex-side-nav apex-icons-fontapex apex-theme-vita-dark\"   id=\"t_PageBody\">\n<noscript class=\"t-PageBody-noScript\">You must run this product with JavaScript enabled</noscript>\n<a href=\"#main\" id=\"t_Body_skipToContent\">Skip to Main Content</a>\n<form role=\"none\" action=\"wwv_flow.accept?p_context=blindfold/vote/<id>\" method=\"post\" name=\"wwv_flow\" id=\"wwvFlowForm\" data-oj-binding-provider=\"none\" novalidate  autocomplete=\"off\">\n<input type=\"hidden\" name=\"p_flow_id\" value=\"2620\" id=\"pFlowId\" /><input type=\"hidden\" name=\"p_flow_step_id\" value=\"1\" id=\"pFlowStepId\" /><input type=\"hidden\" name=\"p_instance\" value=\"<id>\" id=\"pInstance\" /><input type=\"hidden\" name=\"p_page_submission_id\" value=\"MTgzNTM4OTIzODE2MDk5MDY2ODkwMzc0MTQ4Mzk3OTU3ODUyNzQ&#x2F;qKCVZ1PY3sknpdqJ26tDiNyQ1YQTR-YUAA--K5Ks9LIvuPIzpbQODQq9dwQoPNdOl6u-RJZnApnSa1lp4NKO0Q\" id=\"pPageSubmissionId\" /><input type=\"hidden\" name=\"p_request\" value=\"\" id=\"pRequest\" /><input type=\"hidden\" name=\"p_reload_on_submit\" value=\"S\" id=\"pReloadOnSubmit\" /><input type=\"hidden\" value=\"blindfold&#x2F;vote&#x2F;<id>\" id=\"pContext\" /><input type=\"hidden\" value=\"<id>\" id=\"pSalt\" /><input type=\"hidden\" name=\"p_debug\" value=\"LEVEL9\" id=\"pdebug\" />\n<main id=\"main\" class=\"t-Body-contentInner\">\n  <span id=\"APEX_SUCCESS_MESSAGE\" data-template-id=\"<id>_S\" class=\"apex-page-success u-hidden\"></span><span id=\"APEX_ERROR_MESSAGE\" data-template-id=\"<id>_E\" class=\"apex-page-error u-hidden\"></span>\n  <div id=\"R<id>\" class=\"\"  ><div class=\"bf-shell\" data-bf-page=\"vote\">\n  <section class=\"bf-hero\">\n    <p class=\"bf-eyebrow\">Fictional election &middot; educational cryptography</p>\n    <h1 class=\"bf-title\">Best Oracle APEX 26.2 feature</h1>\n    <p class=\"bf-lede\">Pick one. This browser encrypts your choice before anything leaves the page. <strong>The database stores three numbers it cannot read.</strong></p>\n  </section>\n\n  <div class=\"bf-grid\">\n    <section class=\"bf-panel\" id=\"bf-ballot\" aria-labelledby=\"bf-ballot-title\">\n      <h2 class=\"bf-panel__title\" id=\"bf-ballot-title\"><span class=\"bf-step\">1</span>Your ballot</h2>\n      <label class=\"bf-field\">\n        <span class=\"bf-field__label\">Voter code</span>\n        <input class=\"bf-input\" id=\"bf-voter\" type=\"text\" autocomplete=\"off\" autocapitalize=\"characters\" spellcheck=\"false\" placeholder=\"VOTER-0001\" maxlength=\"30\">\n        <span class=\"bf-field__hint\">The code proves you are on the roll. It is recorded apart from the ballot.</span>\n      </label>\n      <span class=\"bf-field__label\" id=\"bf-options-label\">Your choice</span>\n      <div class=\"bf-options\" id=\"bf-options\" role=\"radiogroup\" aria-labelledby=\"bf-options-label\"></div>\n      <button class=\"bf-button bf-button--wide\" id=\"bf-cast\" type=\"button\" disabled>Encrypt and cast ballot</button>\n      <p class=\"bf-message\" id=\"bf-message\" role=\"status\"></p>\n    </section>\n\n    <section class=\"bf-panel\" id=\"bf-receipt\" aria-labelledby=\"bf-receipt-title\" hidden>\n      <h2 class=\"bf-panel__title\" id=\"bf-receipt-title\"><span class=\"bf-step\">1</span>Ballot stored</h2>\n      <p class=\"bf-receipt__id\">Ballot <span id=\"bf-receipt-id\"></span></p>\n      <p class=\"bf-receipt__text\">Three ciphertexts are now rows in <code class=\"bf-hex\">BLIND_BALLOTS</code>. The database cannot tell which one encrypts your vote.</p>\n      <p class=\"bf-receipt__local\"><small>On this screen only</small><span id=\"bf-receipt-choice\"></span></p>\n      <div class=\"bf-actions\">\n        <a class=\"bf-button\" id=\"bf-receipt-link\" href=\"#\">See what the database sees</a>\n        <button class=\"bf-button bf-button--ghost\" id=\"bf-next\" type=\"button\">Next voter</button>\n      </div>\n    </section>\n\n    <section class=\"bf-panel\" aria-labelledby=\"bf-wire-title\">\n      <h2 class=\"bf-panel__title\" id=\"bf-wire-title\"><span class=\"bf-step\">2</span>What leaves this browser</h2>\n      <ol class=\"bf-wire\" id=\"bf-wire\"></ol>\n    </section>\n  </div>\n</div></div>\n</main>\n<div class=\"t-Body-inlineDialogs\" id=\"t_Body_inlineDialogs\"></div>\n<input type=\"hidden\" id=\"pPageFormRegionChecksums\" value=